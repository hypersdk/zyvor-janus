# ForgeSim API — FastAPI + Rust PyO3 extension
#
# Build:
#   docker build -f deploy/docker/Dockerfile.api -t forgesim-api:0.1.0 .
#
# Run:
#   docker run --rm -p 8080:8080 forgesim-api:0.1.0

FROM rust:1-bookworm AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates
COPY pyproject.toml LICENSE NOTICE README.md ./
COPY python python

RUN python3 -m venv /opt/maturin-venv \
  && /opt/maturin-venv/bin/pip install --no-cache-dir "maturin>=1.7,<2.0" \
  && /opt/maturin-venv/bin/maturin build --release --out /wheels

FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --shell /usr/sbin/nologin forgesim

# Configs only — Python package comes from the maturin wheel (do not put
# source tree on PYTHONPATH or a host-built macOS .so will shadow Linux).
COPY configs configs
COPY --from=builder /wheels /wheels

RUN WHEEL="$(ls /wheels/forgesim-*.whl)" \
  && pip install --no-cache-dir "${WHEEL}[server]" \
  && rm -rf /wheels \
  && mkdir -p outputs/runs \
  && chown -R forgesim:forgesim /app

ENV PYTHONUNBUFFERED=1
ENV FORGESIM_ROOT=/app
ENV FORGESIM_CONFIG_DIR=/app/configs/clusters
ENV FORGESIM_RUNS_DIR=/app/outputs/runs
ENV FORGESIM_PROFILES_DIR=/app/configs/profiles

USER forgesim
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health')"

CMD ["uvicorn", "forgesim.server.app:app", "--host", "0.0.0.0", "--port", "8080"]
