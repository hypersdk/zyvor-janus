# Zyvor Janus API — Rust (zyvor-janus-api), replacing the Python/FastAPI
# server. Not yet wired into deploy/docker/Dockerfile.api or any deploy
# script -- this is the Phase 7 standalone build for containerized
# verification ahead of the Phase 8 cutover (see the zyvor-janus-api plan).
#
# Build:
#   docker build -f deploy/docker/Dockerfile.api.rust -t zyvor-janus-api:rust .
#
# Run:
#   docker run --rm -p 8080:8080 \
#     -e ZYVOR_JANUS_API_KEY=... -e ZYVOR_JANUS_WS_TICKET_SECRET=... \
#     zyvor-janus-api:rust

FROM rust:1-bookworm AS builder

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates

RUN cargo build --release -p zyvor-janus-api

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --shell /usr/sbin/nologin zyvor-janus

COPY configs configs
COPY --from=builder /build/target/release/zyvor-janus-api /usr/local/bin/zyvor-janus-api

RUN mkdir -p outputs/runs outputs/twins \
  && chown -R zyvor-janus:zyvor-janus /app

ENV ZYVOR_JANUS_ROOT=/app
ENV ZYVOR_JANUS_CONFIG_DIR=/app/configs/clusters
ENV ZYVOR_JANUS_RUNS_DIR=/app/outputs/runs
ENV ZYVOR_JANUS_PROFILES_DIR=/app/configs/profiles

# ZYVOR_JANUS_API_KEY / ZYVOR_JANUS_WS_TICKET_SECRET are deliberately NOT
# baked in here -- deploy/kubernetes/api.yaml will supply real values from a
# Secret at Phase 8 cutover. If unset, the binary falls back to well-known
# dev defaults (see state.rs) -- the same residual risk Python's server
# already had (openai_shim.py's DEFAULT_API_KEY does the same thing), not a
# new regression, but worth a real Secret in any non-local deployment.

USER zyvor-janus
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1

CMD ["/usr/local/bin/zyvor-janus-api"]
