# Copy to .env.local for local Next.js dev (optional — run_web_dashboard.sh sets these too).
FORGESIM_DASHBOARD_USER=Admin
FORGESIM_DASHBOARD_PASSWORD=Admin@321

# Next's rewrites() can't proxy WebSocket upgrades (next dev / next start both throw
# internally on an upgrade to a rewritten route), so the live run view connects to the
# API directly when this is set. run_web_dashboard.sh / run_web_ui.sh already export it;
# only needed here if you run `next dev` directly without those scripts.
# NEXT_PUBLIC_FORGESIM_WS_URL=ws://127.0.0.1:8080
