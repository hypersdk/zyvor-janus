# Copy to .env.local for local Next.js dev (optional — run_web_dashboard.sh sets these too).
ZYVOR_JANUS_DASHBOARD_USER=Admin
ZYVOR_JANUS_DASHBOARD_PASSWORD=Admin@321

# Shared secret injected as `Authorization: Bearer <token>` by middleware.ts on
# every proxied /api/* and /ws/* request — zyvor-janus-api requires it on every
# route except /api/health. Server-side only (never NEXT_PUBLIC_*), so the
# browser never sees it. Must match the API server's own ZYVOR_JANUS_API_KEY.
# Defaults to "dev-zyvor-janus-key" on both sides if unset, so local dev works
# with no configuration; set a real secret for any non-local deployment.
# ZYVOR_JANUS_API_KEY=dev-zyvor-janus-key

# Next's rewrites() can't proxy WebSocket upgrades (next dev / next start both throw
# internally on an upgrade to a rewritten route), so the live run view connects to the
# API directly when this is set. run_web_dashboard.sh / run_web_ui.sh already export it;
# only needed here if you run `next dev` directly without those scripts.
# NEXT_PUBLIC_ZYVOR_JANUS_WS_URL=ws://127.0.0.1:8080
